  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "glass",
    "frosted-glass",
    "light-theme"
  ],
  "homepage": "https://github.com/joyous-coder/dsh-theme-glass#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joyous-coder/dsh-theme-glass.git"
  },
  "bugs": {
    "url": "https://github.com/joyous-coder/dsh-theme-glass/issues"
  },
  "license": "MIT",
  "author": "joyous-coder",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
